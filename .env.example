# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Payment Gateway (One-Time Consultation Advisory Payments)
# When ready, get these from your Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
# Get this from Stripe Dashboard -> Developers -> Webhooks (or Stripe CLI: stripe listen --forward-to localhost:3000/api/consultations/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Email Engine (For Instant Customer Vouchers & Founder VIP Alerts)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Set your verified domain sender e.g. "Asaheeb Real Estate <consultations@asaheebrealestate.com>"
# If testing before domain verification, defaults to "Asaheeb Real Estate <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Asaheeb Real Estate <onboarding@resend.dev>"

# Cloudinary CDN Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset

